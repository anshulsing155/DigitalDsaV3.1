# ─────────────────────────────────────────────────────────────────────────────
# DigitalDSA — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env — it contains secrets. Only .env.example is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# Database Configuration
MONGODB_URI=mongodb://your_user:your_password@your_cluster_host:27017/digitaldsa?ssl=true&authSource=admin&retryWrites=true&w=majority
MONGODB_DB_NAME=digitaldsa
MONGO_ENSURE_INDEXES=false

# JWT Configuration
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
AUTH_SECRET=your_auth_secret_here

# MSG91 Configuration (OTP provider)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_WIDGET_ID=your_msg91_widget_id_here
MSG91_TOKEN_AUTH=your_msg91_token_auth_here

# Encryption Configuration
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
HMAC_SECRET=your_128_char_hex_hmac_secret_here
VITE_HMAC_SECRET=your_128_char_hex_hmac_secret_here

# Session Configuration
SESSION_SECRET=your_128_char_hex_session_secret_here
SESSION_MAX_AGE=86400000

# API Configuration
VITE_API_BASE_URL=http://localhost:10000
VITE_WS_BASE_URL=ws://localhost:10000

# ImageKit Configuration (file uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id_here

# App Configuration
VITE_APP_NAME=DigitalDSA
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CSRF Configuration
CSRF_SECRET=your_128_char_hex_csrf_secret_here

# Application Configuration
NODE_ENV=development
PORT=5173
APP_URL=http://localhost:5173

# Backend Configuration
BACKEND_PORT=10000
BACKEND_URL=http://localhost:10000

# CORS Configuration
CORS_ORIGIN=https://your-production-domain.com
CORS_ORIGINS=http://localhost:5173,capacitor://localhost

# Razorpay Configuration (payments)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Email Configuration (SMTP)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com
ORIGIN=https://your-production-domain.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log


# Analytics Warehouse (DATA-4) — secret behind the one-way person_id bridge.
# >= 32 chars; generate with `openssl rand -hex 32`. Do NOT rotate routinely
# (breaks unique-person continuity — see DATA-4 spec §8).
ANALYTICS_PEPPER=your_64_char_hex_analytics_pepper_here
