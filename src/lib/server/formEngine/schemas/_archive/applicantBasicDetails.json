{
	"applicant": [
		{
			"id": "q_applicantName",
			"key": "fullNameOfApplicant",
			"type": "text",
			"inputRestriction": "alphabet",
			"maxlength": 50,
			"required": true,
			"icon": "user",
			"question": "What's the full name of the Applicant?",
			"placeholder": "Enter full name",
			"showWhen": {
				"==": ["applicantType", "Individual"]
			}
		},
		{
			"id": "q_applicantAge",
			"key": "age",
			"type": "number",
			"icon": "calendar",
			"required": true,
			"inputRestriction": "numeric",
			"maxlength": 2,
			"question": "What is the current age of applicant?",
			"placeholder": "Enter Age",
			"showWhen": {
				"==": ["applicantType", "Individual"]
			}
		},
		{
			"id": "q_applicantGender",
			"key": "gender",
			"type": "selection",
			"icon": "venus-and-mars",
			"required": true,
			"question": "Select gender of the applicant",
			"placeholder": "Select gender",
			"options": [
				{
					"label": "Male",
					"value": "male"
				},
				{
					"label": "Female",
					"value": "female"
				}
			],
			"showWhen": {
				"==": ["applicantType", "Individual"]
			}
		},
		{
			"id": "q_employmentType",
			"key": "employmentType",
			"type": "selection",
			"icon": "briefcase-business",
			"required": true,
			"question": "What's applicant's employment status?",
			"placeholder": "Select Employment Type",
			"options": [
				{
					"label": "Government",
					"value": "Salaried(Government)"
				},
				{
					"label": "Private",
					"value": "Salaried(Private)"
				}
			],
			"showWhen": {
				"and": [
					{
						"==": ["applicantType", "Individual"]
					},
					{
						"==": ["loanName", "Personal Loan"]
					}
				]
			}
		},
		{
			"id": "q_companyName",
			"key": "companyName",
			"type": "text",
			"inputRestriction": "alphanumeric",
			"maxlength": 50,
			"icon": "user",
			"required": true,
			"question": "Enter company Name?",
			"placeholder": "Enter Name",
			"showWhen": {
				"==": ["applicantType", "company"]
			}
		}
	]
}
