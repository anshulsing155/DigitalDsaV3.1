{
	"questions": [
		{
			"id": "q_applicantType",
			"key": "applicantType",
			"question": "Applicant Type",
			"description": "<div class='info-title'><span class='info-icon blue'>👤</span> Applicant Type Selection</div><div class='info-box highlight'>Choose whether the applicant is an <span class='bold'>individual person</span> or a <span class='bold'>company entity</span>.</div><div class='stats-row'><div class='stat-item'><div class='stat-value'>👤</div><div class='stat-label'>Individual</div></div><div class='stat-item'><div class='stat-value'>🏢</div><div class='stat-label'>Company</div></div></div><div class='info-box note'><span class='bold'>Note:</span> Different documentation requirements apply based on your selection.</div>",
			"type": "radio",
			"styleClass": "col-span-2",
			"required": true,
			"options": [
				{
					"label": "Individual",
					"value": "Individual",
					"icon": "User"
				},
				{
					"label": "Company",
					"value": "Company",
					"icon": "Building"
				}
			],
			"validation": {
				"condition": [
					{
						"case": {
							"or": [
								{
									"==": [
										{
											"var": "applicantType"
										},
										""
									]
								},
								{
									"==": [
										{
											"var": "applicantType"
										},
										null
									]
								}
							]
						},
						"then": "Applicant Type is required"
					}
				]
			}
		},
		{
			"id": "q_fullName",
			"key": "fullNameOfApplicant",
			"styleClass": "col-span-2",
			"question": "Enter full name",
			"description": "<div class='info-title'><span class='info-icon blue'>👤</span> Full Name Requirement</div><div class='info-box highlight'>Enter your name <span class='bold'>exactly as it appears</span> on your official documents.</div><ul class='info-list'><li>PAN Card</li><li>Aadhaar Card</li><li>Passport</li></ul><div class='info-box tip'><span class='bold'>Tip:</span> Use proper capitalization and spelling to avoid verification issues later.</div>",
			"placeholder": "Enter full name",
			"type": "text",
			"icon": "user",
			"inputRestriction": "alphabet",
			"maxlength": 50,
			"maxLengthErrorMessage": "Name must not exceed 50 characters",
			"required": true,
			"showWhen": {
				"==": ["applicantType", "Individual"]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"==": [
								{
									"var": "fullNameOfApplicant"
								},
								""
							]
						},
						"then": "Name is required"
					},
					{
						"case": {
							"==": [
								{
									"var": "fullNameOfApplicant.1"
								},
								null
							]
						},
						"then": "Name must contain at least 2 characters"
					}
				]
			}
		},
		{
			"id": "q_gender",
			"key": "gender",
			"question": "Gender",
			"description": "<div class='info-title'><span class='info-icon green'>⚧</span> Gender Information</div><div class='info-box highlight'>Select your gender as per your <span class='bold'>official identity documents</span>.</div><div class='info-box note'><span class='bold'>Note:</span> This information is required for loan documentation and processing purposes.</div>",
			"type": "select",
			"styleClass": "col-span-1",
			"icon": "venus-and-mars",
			"required": true,
			"options": [
				{
					"label": "Male",
					"value": "male"
				},
				{
					"label": "Female",
					"value": "female"
				}
			],
			"showWhen": {
				"==": ["applicantType", "Individual"]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"or": [
								{
									"==": [
										{
											"var": "gender"
										},
										""
									]
								},
								{
									"==": [
										{
											"var": "gender"
										},
										null
									]
								}
							]
						},
						"then": "Gender is required"
					}
				]
			}
		},
		{
			"id": "q_maritalStatus",
			"key": "maritalStatus",
			"question": "Marital Status",
			"description": "<div class='info-title'><span class='info-icon gold'>💑</span> Marital Status</div><div class='info-box highlight'>Your marital status helps in determining <span class='bold'>co-applicant requirements</span> and property ownership.</div><div class='info-box tip'><span class='bold'>Tip:</span> If married, adding spouse as co-applicant can improve loan eligibility!</div>",
			"styleClass": "col-span-1",
			"type": "select",
			"icon": "users",
			"required": true,
			"options": [
				{
					"label": "Single",
					"value": "single"
				},
				{
					"label": "Married",
					"value": "married"
				},
				{
					"label": "Divorced",
					"value": "divorced"
				},
				{
					"label": "Separated",
					"value": "separated"
				},
				{
					"label": "Widowed",
					"value": "widowed"
				}
			],
			"showWhen": {
				"==": ["applicantType", "Individual"]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"or": [
								{
									"==": [
										{
											"var": "maritalStatus"
										},
										""
									]
								},
								{
									"==": [
										{
											"var": "maritalStatus"
										},
										null
									]
								}
							]
						},
						"then": "Maritial status is required"
					}
				]
			}
		},
		{
			"id": "q_age",
			"key": "age",
			"question": "Age",
			"description": "<div class='info-title'><span class='info-icon gold'>📅</span> Age Requirements</div><div class='info-box highlight'>Your age determines <span class='bold'>loan eligibility</span> and maximum tenure.</div><div class='visual-diagram'><div class='diagram-row'><span class='diagram-label'>Minimum Age</span><span class='diagram-value'>18 years</span></div><div class='diagram-row'><span class='diagram-label'>Maximum Age (at maturity)</span><span class='diagram-value'>65-70 years</span></div></div><div class='info-box note'><span class='bold'>Note:</span> Younger applicants qualify for longer loan tenures, reducing EMI burden.</div>",
			"styleClass": "col-span-1",
			"placeholder": "Enter age",
			"type": "text",
			"inputRestriction": "numeric",
			"maxlength": 2,
			"icon": "calendar",
			"required": true,
			"showWhen": {
				"==": ["applicantType", "Individual"]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"or": [
								{
									"==": [
										{
											"var": "age"
										},
										null
									]
								},
								{
									"==": [
										{
											"var": "age"
										},
										""
									]
								},
								{
									"==": [
										{
											"var": "age"
										},
										0
									]
								}
							]
						},
						"then": "Age is required"
					},
					{
						"case": {
							"<": [
								{
									"var": "age"
								},
								18
							]
						},
						"then": "Age must be at least 18 years"
					},
					{
						"case": {
							">": [
								{
									"var": "age"
								},
								80
							]
						},
						"then": "Age must not be more than 80 years"
					}
				]
			}
		},
		{
			"id": "q_isApplicantNRI",
			"key": "isApplicantNRI",
			"question": "Is NRI?",
			"description": "<div class='info-title'><span class='info-icon blue'>🌍</span> NRI Status</div><div class='info-box highlight'>Indicate if the applicant is a <span class='bold'>Non-Resident Indian (NRI)</span>.</div><ul class='info-list'><li>NRIs living/working abroad</li><li>Different documentation requirements apply</li><li>Some lenders offer special NRI loan programs</li></ul><div class='info-box note'><span class='bold'>Note:</span> NRI applicants may need Power of Attorney for property transactions in India.</div>",
			"styleClass": "col-span-1",
			"type": "select",
			"icon": "flag",
			"required": true,
			"options": [
				{
					"label": "Yes",
					"value": "Yes",
					"icon": "ThumbsUp"
				},
				{
					"label": "No",
					"value": "No",
					"icon": "ThumbsDown"
				}
			],
			"showWhen": {
				"==": ["applicantType", "Individual"]
