			"validation": {
				"condition": [
					{
						"case": {
							"or": [
								{
									"==": [
										{
											"var": "isApplicantNRI"
										},
										""
									]
								},
								{
									"==": [
										{
											"var": "isApplicantNRI"
										},
										null
									]
								}
							]
						},
						"then": "NRI status is required"
					}
				]
			}
		},
		{
