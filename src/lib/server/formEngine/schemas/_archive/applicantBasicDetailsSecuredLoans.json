		{
			"id": "q_numberOfDirectorsOrPartners",
			"key": "numberOfDirectorsOrPartners",
			"question": "Number of Directors / Partners",
			"description": "<div class='info-title'><span class='info-icon gold'>👥</span> Directors / Partners</div><div class='info-box highlight'>Enter the total number of <span class='bold'>directors, partners, or trustees</span> in this entity.</div><div class='info-box note'><span class='bold'>Note:</span> You'll be asked for each director's details in the next step.</div>",
			"type": "select",
			"styleClass": "col-span-1",
			"icon": "users",
			"required": true,
			"options": [
				{ "label": "2", "value": "2" },
				{ "label": "3", "value": "3" },
				{ "label": "4", "value": "4" },
				{ "label": "5", "value": "5" },
				{ "label": "6+", "value": "6" }
			],
			"showWhen": {
				"and": [
					{ "==": ["applicantType", "Company"] },
					{ "!=": ["companyType", "One Person Company (OPC)"] }
				]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"or": [
								{ "==": [{ "var": "numberOfDirectorsOrPartners" }, ""] },
								{ "==": [{ "var": "numberOfDirectorsOrPartners" }, null] }
							]
						},
						"then": "Number of directors/partners is required"
					}
				]
			}
		},
		{
			"id": "q_hasRelatedDirectors",
			"key": "hasRelatedDirectors",
			"question": "Are any directors/partners related?",
			"description": "<div class='info-title'><span class='info-icon blue'>👨‍👩‍👦</span> Director Relationships</div><div class='info-box highlight'>Indicate if any directors or partners are <span class='bold'>related to each other</span> — family, extended family, or in-laws.</div><div class='info-box tip'><span class='bold'>Why it matters:</span> Lenders evaluate family-run businesses differently. All related directors may need individual CIBIL checks.</div>",
			"type": "radio",
			"styleClass": "col-span-2",
			"icon": "users",
			"required": true,
			"options": [
				{
					"label": "Yes, some or all are related",
					"value": "yes",
					"icon": "Users"
				},
				{
					"label": "No, none are related",
					"value": "no",
					"icon": "UserX"
				}
			],
			"showWhen": {
				"and": [
					{ "==": ["applicantType", "Company"] },
					{ "!=": ["companyType", "One Person Company (OPC)"] }
				]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"or": [
								{ "==": [{ "var": "hasRelatedDirectors" }, ""] },
								{ "==": [{ "var": "hasRelatedDirectors" }, null] }
							]
						},
						"then": "Please indicate if directors/partners are related"
					}
				]
			}
		},
		{
			"id": "q_onProperty",
			"key": "onProperty",
			"type": "booleanSelect",
			"styleClass": "col-span-1",
			"question": "Name on property?",
			"description": "<div class='info-title'><span class='info-icon green'>🏠</span> Property Ownership</div><div class='info-box highlight'>Indicate if this applicant's <span class='bold'>name will be on the property</span> documents.</div><div class='info-box tip'><span class='bold'>Why it matters:</span> All property owners must be applicants/co-applicants for secured loans.</div><div class='info-box note'><span class='bold'>Note:</span> At least one applicant with income must have their name on the property.</div>",
			"icon": "fence",
