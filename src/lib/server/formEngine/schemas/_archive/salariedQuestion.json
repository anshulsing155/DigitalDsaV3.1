		{
			"id": "q_grossIncome",
			"key": "grossIncome",
			"required": true,
			"type": "number",
			"question": "What is the monthly gross income?",
			"description": "<div class='info-title'><span class='info-icon gold'>💰</span> Understanding Gross Income</div><div class='info-box highlight'><strong>Gross Income</strong> is your total monthly salary <em>before</em> any deductions are made.</div><div class='visual-diagram'><div class='diagram-row'><span>Basic Salary</span><span class='diagram-value'>₹ XX,XXX</span></div><div class='diagram-row'><span>HRA</span><span class='diagram-value'>+ ₹ X,XXX</span></div><div class='diagram-row'><span>Special Allowance</span><span class='diagram-value'>+ ₹ X,XXX</span></div><div class='diagram-row'><span>Other Allowances</span><span class='diagram-value'>+ ₹ X,XXX</span></div><div class='info-divider'></div><div class='diagram-row'><strong>Gross Salary</strong><span class='diagram-value highlight-text'>= ₹ XX,XXX</span></div></div><div class='info-box tip'><span class='bold'>Where to find it?</span><br/>Check your salary slip - it's usually labeled as <em>\"Gross Salary\"</em> or <em>\"Total Earnings\"</em> at the top.</div>",
			"icon": "IndianRupee",
			"showNumberInWords": true,
			"validation": {
				"condition_1": [
					{
						"case": {
							"<": [
								{
									"var": "grossIncome"
								},
								15000
							]
						},
						"grossIncomeError": "Gross salary should be greater than or equal to 15,000"
					},
					{
						"case": {
							">": [
								{
									"var": "grossIncome"
								},
								9999999999
							]
						},
						"grossIncomeError": "Enter a valid amount"
					}
				],
				"condition_2": [
					{
						"case": {
							">": [
								{
									"var": "netIncome"
								},
								{
									"var": "grossIncome"
								}
							]
						},
						"netIncomeError": "Net Income cannot be greater than Gross Income"
					},
					{
						"case": {
							"<": [
								{
									"var": "netIncome"
								},
								{
									"var": "grossIncome"
								}
							]
						},
						"netIncomeError": ""
					}
				]
			},
			"showWhen": {
				"and": [
					{
						"==": ["salariedActivityDetailsValidate", true]
					}
				]
			}
		},
		{
			"id": "q_netIncome",
			"key": "netIncome",
			"required": true,
			"type": "number",
			"question": "What is the monthly net income?",
			"description": "<div class='info-title'><span class='info-icon blue'>🏦</span> Understanding Net Income</div><div class='info-box highlight'><strong>Net Income</strong> is your <em>take-home salary</em> — the amount credited to your bank account after all deductions.</div><div class='visual-diagram'><div class='diagram-row'><span>Gross Salary</span><span class='diagram-value'>₹ XX,XXX</span></div><div class='diagram-row' style='color: #dc2626;'><span>(-) PF Deduction</span><span class='diagram-value'>- ₹ X,XXX</span></div><div class='diagram-row' style='color: #dc2626;'><span>(-) Professional Tax</span><span class='diagram-value'>- ₹ XXX</span></div><div class='diagram-row' style='color: #dc2626;'><span>(-) TDS / Income Tax</span><span class='diagram-value'>- ₹ X,XXX</span></div><div class='info-divider'></div><div class='diagram-row'><strong>Net Salary (In-Hand)</strong><span class='diagram-value highlight-text'>= ₹ XX,XXX</span></div></div><div class='info-box tip'><span class='bold'>Where to find it?</span><br/>Check your bank statement for the salary credit amount, or look for <em>\"Net Pay\"</em> or <em>\"Take Home\"</em> on your salary slip.</div>",
			"icon": "IndianRupee",
			"showNumberInWords": true,
			"validation": {
				"condition": [
					{
						"case": {
							"<": [
								{
									"var": "netIncome"
								},
								20000
							]
						},
						"netIncomeError": "Net Income should be greater than or equal to 20,000"
					},
					{
						"case": {
							">": [
								{
									"var": "netIncome"
								},
								9999999999
							]
						},
						"netIncomeError": "Enter a valid amount"
					},
					{
						"case": {
							">": [
								{
									"var": "netIncome"
								},
								{
									"var": "grossIncome"
								}
							]
						},
						"netIncomeError": "Net Income cannot be greater than Gross Income"
					}
				]
			},
			"showWhen": {
				"and": [
					{
						"==": ["salariedActivityDetailsValidate", true]
					},
					{
						">": ["grossIncome", 0]
					}
				]
			}
		},
		{
			"id": "q_monthlyOtherIncome",
			"key": "monthlyOtherIncome",
			"required": true,
			"type": "number",
			"question": "What's the additional monthly income from bonuses, incentives, government pension and rental earnings?",
			"icon": "IndianRupee",
			"showNumberInWords": true,
			"showWhen": {
				"and": [
					{
						"==": ["salariedActivityDetailsValidate", true]
					},
					{
						">": ["grossIncome", 0]
					},
