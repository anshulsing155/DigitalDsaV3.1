					},
					{
						"and": [
							{
								">": ["grossIncome", 0]
							},
							{
								">": ["netIncome", 0]
							},
							{
								"==": ["salariedActivityDetailsValidate", true]
							},
							{
								"!=": ["loanName", "Personal Loan"]
