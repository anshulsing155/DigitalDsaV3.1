{
	"businessOtherApplicant": [
		{
			"id": "q_businessType",
			"question": "Select the primary source of business income",
			"key": "businessType",
			"type": "radio",
			"required": true,
			"options": [
				{
					"label": "Manufacturer / Producer",
					"value": "manufacturing",
					"icon": "HardHat"
				},
				{
					"label": "Trading / Retailer",
					"value": "trading",
					"icon": "Store"
				},
				{
					"label": "B2B Services",
					"value": "b2b_services",
					"icon": "Handshake"
				},
				{
					"label": "B2C Services",
					"value": "b2c_services",
					"icon": "Users"
				},
				{
					"label": "Commission based business",
					"value": "commission-business",
					"icon": "Percent"
				},
				{
					"label": "Freelancer / Gig worker",
					"value": "freelancer-gig",
					"icon": "Laptop"
				}
			],
			"showWhen": {
				"==": ["employmentType", "Self-employed(Other)"]
			}
		},
		{
			"id": "q_businessActivityDetails",
			"key": "businessActivityDetails",
			"type": "multiple-select",
			"required": true,
			"question": "Share key details about your business",
			"descriptionHeader": "Provide accurate business details. Lenders use this for credit assessment.",
			"options": [
				{
					"label": "Has valid GST registration",
					"value": "gst_registered",
					"optionsDescription": "Indicates formal tax compliance and turnover."
				},
				{
					"label": "Has active current account",
					"value": "has_current_account",
					"optionsDescription": "Shows formal banking and transaction trail."
				},
				{
					"label": "Uses personal/family savings account for income",
					"value": "has_saving_account",
					"optionsDescription": "Acceptable if no current account.",
					"showWhen": {
						"and": [
							{
								"==": ["businessActivityDetailsVisible.has_current_account", false]
							},
							{
								"==": ["employmentType", "Self-employed(Other)"]
							}
						]
					}
				},
				{
					"label": "Files ITR regularly (min 2 years)",
					"value": "itr_filed_regularly",
					"optionsDescription": "Essential for income proof.",
					"showWhen": {
						"==": ["employmentType", "Self-employed(Other)"]
					}
				},
				{
					"label": "Has been profitable for the last 3 years",
					"value": "profit_last_3_years",
					"optionsDescription": "Shows business stability.",
					"showWhen": {
						"and": [
							{
								"==": ["businessActivityDetailsVisible.itr_filed_regularly", true]
							},
							{
								"==": ["businessActivityDetailsVisible.business_3plus_years", true]
							},
							{
								"==": ["employmentType", "Self-employed(Other)"]
							}
						]
					}
				},
				{
					"label": "Has been profitable since inception",
					"value": "profit_since_starting",
					"optionsDescription": "Strong business performance.",
					"showWhen": {
						"and": [
							{
								"==": ["businessActivityDetailsVisible.itr_filed_regularly", true]
							},
							{
								"==": ["businessActivityDetailsVisible.business_3plus_years", false]
							},
							{
								"==": ["employmentType", "Self-employed(Other)"]
							}
						]
					}
				},
				{
					"label": "More than 40% of income is in cash",
					"value": "major_cash_sales",
					"optionsDescription": "Reduces income transparency.",
					"showWhen": {
						"==": ["employmentType", "Self-employed(Other)"]
					}
				},
				{
					"label": "Most income from 1–2 key clients",
					"value": "very_few_clients",
					"optionsDescription": "Client concentration risk.",
					"showWhen": {
						"==": ["employmentType", "Self-employed(Other)"]
					}
				},
				{
					"label": "Running CC/OD in current account",
					"value": "has_cc_od",
					"optionsDescription": "Indicates existing leverage.",
					"showWhen": {
						"and": [
							{
								"==": ["businessActivityDetailsVisible.has_current_account", true]
							},
							{
								"==": ["employmentType", "Self-employed(Other)"]
							}
						]
					}
				},
				{
					"label": "Business is seasonal in nature",
					"value": "seasonal_business",
					"optionsDescription": "Helps assess income stability.",
					"showWhen": {
						"==": ["employmentType", "Self-employed(Other)"]
					}
				},
				{
					"label": "Has additional income sources (rent, investment, etc.)",
					"value": "has_other_income_source",
					"optionsDescription": "Improves repayment capacity.",
					"showWhen": {
						"==": ["employmentType", "Self-employed(Other)"]
					}
				},
				{
					"label": "Applicant has 2+ years experience in same line of business",
					"value": "two_years_experience_before_business",
					"optionsDescription": "Shows domain expertise.",
					"showWhen": {
						"and": [
							{
								">=": ["age", 25]
							},
							{
								"==": ["businessActivityDetailsVisible.business_3plus_years", false]
							},
							{
								"==": ["employmentType", "Self-employed(Other)"]
							}
						]
					}
				},
				{
					"label": "Owns or rents a factory, workshop or warehouse",
					"value": "has_factory_or_warehouse",
					"optionsDescription": "Shows business scale.",
					"showWhen": {
						"and": [
							{
								"==": ["employmentType", "Self-employed(Other)"]
							},
							{
								"==": ["businessType", "manufacturing"]
							}
						]
					}
				},
				{
					"label": "Maintains visible inventory or stock",
					"value": "has_inventory",
					"optionsDescription": "Shows organized operations.",
					"showWhen": {
						"and": [
							{
								"==": ["employmentType", "Self-employed(Other)"]
							},
							{
								"in": ["businessType", ["manufacturing", "trading"]]
							}
						]
					}
				},
				{
					"label": "Uses family member's savings account for business",
					"value": "use_savingAccount_family",
					"optionsDescription": "Acceptable but less preferred.",
					"showWhen": {
						"and": [
							{
								"==": ["businessActivityDetailsVisible.has_saving_account", true]
							},
							{
								"==": ["employmentType", "Self-employed(Other)"]
							}
						]
					}
				}
			],
			"showWhen": {
				"and": [
					{
						"==": ["employmentType", "Self-employed(Other)"]
					},
					{
						"in": [
							"businessType",
							[
								"freelancer-gig",
								"commission-business",
								"b2c_services",
								"b2b_services",
								"trading",
								"manufacturing"
							]
						]
					}
				]
			}
		},
		{
			"id": "q3_addressSameOrNot",
			"question": "Is your GST registered address the same as your actual business address?",
			"key": "addressSameOrNot",
			"type": "radio",
			"required": true,
			"options": [
				{
					"label": "Yes",
					"value": "Yes",
					"flagKey": {
						"isAddressSame": true
					},
					"uiMeta": {
						"icon": "Circle"
					},
					"icon": "ThumbsUp"
				},
				{
					"label": "No",
					"value": "No",
					"flagKey": {
						"isAddressSame": false
					},
					"uiMeta": {
						"icon": "Circle"
					},
					"icon": "ThumbsDown"
				}
			],
			"showWhen": {
				"and": [
					{
						"==": ["businessActivityDetailsVisible.gst_registered", true]
					},
					{
						"==": ["businessActivityDetailsValidate", true]
					}
				]
			}
		},
		{
			"id": "q_GSTRegistrationYear",
			"question": "When did you register for GST?",
			"key": "GSTRegistrationYear",
			"type": "month-year",
			"required": true,
			"showWhen": {
				"and": [
					{
						"==": ["businessActivityDetailsVisible.gst_registered", true]
					},
					{
						"==": ["businessActivityDetailsValidate", true]
					},
					{
						"!=": ["addressSameOrNot", ""]
					}
				]
			}
		},
		{
			"id": "q_selectedBusinessExperience",
			"question": "How many years of experience do you have in this business?",
			"key": "selectedBusinessExperience",
			"type": "radio",
			"required": true,
			"options": [
				{
					"label": "Less than 1 year",
					"value": "1",
					"icon": "Calendar"
				},
				{
					"label": "1-2 years",
					"value": "2",
					"icon": "Calendar"
				},
				{
					"label": "2-3 years",
					"value": "3",
					"icon": "Calendar"
				},
				{
					"label": "More than 3 years",
					"value": "3plus",
					"icon": "CalendarFold"
				}
			],
			"showWhen": {
				"or": [
					{
						"and": [
							{
								"==": ["businessActivityDetailsVisible.gst_registered", true]
							},
							{
								"!=": ["GSTRegistrationYear", ""]
							},
							{
								"==": ["businessActivityDetailsValidate", true]
							},
							{
								"!=": ["addressSameOrNot", ""]
							}
						]
					},
					{
						"and": [
							{
								"==": ["businessActivityDetailsVisible.gst_registered", false]
							},
							{
								"==": ["businessActivityDetailsValidate", true]
							}
						]
					}
				]
			}
		},
		{
			"id": "q5_financialsTable",
			"question": "Provide your financial details (Profit, Depreciation, Turnover)",
			"key": "financialsTable",
			"type": "table",
			"uiGroup": "table_fields",
			"required": true,
			"uiMeta": {
				"headers": [],
				"rows": [
					{
						"label": "ITR filed",
						"field": "itrFiled",
						"icons": ["indian-rupee", "indian-rupee", "indian-rupee"]
					},
					{
						"label": "Net Profit / Loss <br /> <p class=\"alertText font-paragraph text-black\">(as per <span class=\" font-titleMedium inputText \">ITR</span>)</p>",
						"field": "netProfitArray",
						"icons": ["indian-rupee", "indian-rupee", "indian-rupee"]
					},
					{
						"label": "Depreciation + Interest <br /> <p class=\"alertText font-paragraph text-black\">(as per <span class=\" font-titleMedium inputText \">ITR</span>)</p>",
						"field": "depreciationArray",
						"icons": ["indian-rupee", "indian-rupee", "indian-rupee"]
					},
					{
						"label": "GST Turnover / Gross Receipts",
						"field": "turnOverArray",
						"icons": ["indian-rupee", "indian-rupee", "indian-rupee"]
					}
				]
			},
			"showWhen": {
				"or": [
					{
						"and": [
							{
								"==": ["businessActivityDetailsVisible.gst_registered", true]
							},
							{
								"!=": ["GSTRegistrationYear", ""]
							},
							{
								"==": ["businessActivityDetailsValidate", true]
							},
							{
								"!=": ["selectedBusinessExperience", ""]
							}
						]
					},
					{
						"and": [
							{
								"==": ["businessActivityDetailsVisible.gst_registered", false]
							},
							{
								"==": ["businessActivityDetailsValidate", true]
							},
							{
								"!=": ["selectedBusinessExperience", ""]
							}
						]
					}
				]
			}
		},
		{
			"id": "q_averageBankBalance",
			"question": "Enter your average balance in current account (12 months)",
			"key": "averageBankBalance",
			"type": "number",
			"showNumberInWords": true,
			"required": true,
			"showWhen": {
				"and": [
					{
						"==": ["businessActivityDetailsVisible.has_current_account", true]
					},
					{
						"!=": ["selectedBusinessExperience", ""]
					},
					{
						"==": ["businessActivityDetailsVisible.has_cc_od", false]
					},
					{
						"==": ["businessActivityDetailsValidate", true]
					}
				]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"<": [
								{
									"var": "averageBankBalance"
								},
								20000
							]
						},
						"averageBankBalanceError": "Average Balance should be greater than or equal to 20,000"
					},
					{
						"case": {
							">": [
								{
									"var": "averageBankBalance"
								},
								9999999999
							]
						},
						"averageBankBalanceError": "Enter a valid amount"
					}
				]
			}
		},
		{
			"id": "q_cashAmount",
			"question": "Enter your average monthly cash sales (last FY)",
			"key": "cashAmount",
			"type": "number",
			"showNumberInWords": true,
			"required": true,
			"showWhen": {
				"and": [
					{
						"!=": ["selectedBusinessExperience", ""]
					},
					{
						"or": [
							{
								"and": [
									{
										"==": ["businessActivityDetailsVisible.major_cash_sales", true]
									},
									{
										"==": ["businessActivityDetailsValidate", true]
									}
								]
							},
							{
								"and": [
									{
										"==": ["businessActivityDetailsVisible.has_current_account", false]
									},
									{
										"==": ["businessActivityDetailsVisible.itr_filed_regularly", false]
									},
									{
										"==": ["businessActivityDetailsVisible.gst_registered", false]
									},
									{
										"==": ["businessActivityDetailsValidate", true]
									}
								]
							},
							{
								"and": [
									{
										"==": ["businessActivityDetailsVisible.has_current_account", true]
									},
									{
										"==": ["businessActivityDetailsVisible.has_cc_od", false]
									},
									{
										"==": ["businessActivityDetailsVisible.itr_filed_regularly", false]
									},
									{
										"==": ["businessActivityDetailsVisible.gst_registered", false]
									},
									{
										"==": ["businessActivityDetailsValidate", true]
									}
								]
							},
							{
								"and": [
									{
										"==": ["businessActivityDetailsVisible.has_current_account", true]
									},
									{
										"==": ["businessActivityDetailsVisible.has_cc_od", true]
									},
									{
										"==": ["businessActivityDetailsVisible.itr_filed_regularly", false]
									},
									{
										"==": ["businessActivityDetailsVisible.gst_registered", false]
									},
									{
										"==": ["businessActivityDetailsValidate", true]
									}
								]
							}
						]
					}
				]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"<": [
								{
									"var": "cashAmount"
								},
								20000
							]
						},
						"cashAmountError": "Cash Sale must be at least 20000"
					},
					{
						"case": {
							">": [
								{
									"var": "cashAmount"
								},
								99999999999
							]
						},
						"cashAmountError": "Enter a valid amount"
					}
				]
			}
		},
		{
			"id": "q_creditScore",
			"question": "What is your credit score?",
			"key": "creditScore",
			"description": "<div class='info-title'><span class='info-icon gold'>⭐</span> Understanding Credit Score (CIBIL)</div><div class='info-box highlight'>Your <strong>Credit Score</strong> is a 3-digit number (300-900) that represents your creditworthiness based on your credit history.</div><div class='stats-row'><div class='stat'><span class='stat-value' style='color: #dc2626;'>300-549</span><span class='stat-label'>Poor</span></div><div class='stat'><span class='stat-value' style='color: #f59e0b;'>550-649</span><span class='stat-label'>Fair</span></div><div class='stat'><span class='stat-value' style='color: #10b981;'>650-749</span><span class='stat-label'>Good</span></div><div class='stat'><span class='stat-value' style='color: #059669;'>750-900</span><span class='stat-label'>Excellent</span></div></div><div class='info-box tip'><span class='bold'>How to check your score?</span><br/>Visit <em>cibil.com</em> or use apps like Paytm, PhonePe, or your bank's app to get a free credit report.</div><div class='info-box note'><span class='bold'>Note:</span> A score of 750+ increases your chances of loan approval and better interest rates.</div>",
			"type": "number",
			"showNumberInWords": false,
			"icon": "Sparkles",
			"maxLength": 3,
			"max": 900,
			"required": true,
			"showWhen": {
				"==": ["businessActivityDetailsValidate", true]
			},
			"validation": {
				"condition": [
					{
						"case": {
							"<": [
								{
									"var": "creditScore"
								},
								300
							]
						},
						"creditScoreError": "Credit Score must be at least 300"
					},
					{
						"case": {
							">": [
								{
									"var": "creditScore"
								},
								900
							]
						},
						"creditScoreError": "Credit Score must be at most 900"
					}
				]
			}
		},
		{
			"id": "q_whyPrimaryLowCredit",
			"key": "whyPrimaryLowCredit",
			"required": true,
			"type": "multiple-select",
			"question": "What factors have contributed to this CIBIL score?",
			"description": "Please share honestly. Any incorrect or inconsistent information can lead to delays or rejection of the loan application.",
			"showWhen": {
				"and": [
					{
						">=": ["creditScore", 300]
					},
					{
						"<=": ["creditScore", 699]
					},
					{
						"==": ["businessActivityDetailsValidate", true]
					}
				]
			},
			"options": [
				{
					"label": "Delayed EMI payments in the past 12 months",
					"value": "delayedEMI"
				},
				{
					"label": "High utilization of available credit card limit",
					"value": "highCreditUtilization"
				},
				{
					"label": "Limited or no credit history",
					"value": "noCreditHistory"
				},
				{
					"label": "Only minimum due payments made on credit cards",
					"value": "minimumDueOnly"
				},
				{
					"label": "Multiple recent loan or credit card enquiries",
					"value": "multipleEnquiries"
				},
				{
					"label": "Defaulted in one or more previous loans as co-applicant / guarantor",
					"value": "coApplicantDefault"
				},
				{
					"label": "Loan default or settlement in the past",
					"value": "loanDefault"
				},
				{
					"label": "Only unsecured loans such as credit cards or personal loans in profile",
					"value": "onlyUnsecuredLoans"
				}
			]
		},
		{
			"id": "q_Obligation",
			"key": "ObligationsRunning",
			"required": true,
			"type": "radio",
			"question": "Does this applicant have any running loans as borrower or co-applicant?",
			"options": [
				{
					"label": "Yes",
					"value": "Yes",
					"icon": "ThumbsUp"
				},
				{
					"label": "No",
					"value": "No",
					"icon": "ThumbsDown"
				}
			],
			"showWhen": {
				"and": [
					{
						">=": ["creditScore", 300]
					},
					{
						"==": ["whyPrimaryLowCreditValidate", true]
					},
					{
						"==": ["businessActivityDetailsValidate", true]
					}
				]
			}
		}
	]
}
