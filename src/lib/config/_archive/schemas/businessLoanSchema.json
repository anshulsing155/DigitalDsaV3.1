					"options": [
						{
							"label": "Less than 1 year",
							"value": "less_than_1",
							"icon": "AlertTriangle"
						},
						{
							"label": "1-2 years",
							"value": "1_to_2",
							"icon": "Clock"
						},
						{
							"label": "2-3 years",
							"value": "2_to_3",
							"icon": "Clock"
						},
