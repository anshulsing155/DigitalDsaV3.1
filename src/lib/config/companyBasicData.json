{
	"company": [
		{
			"id": "q_companyName",
			"key": "companyName",
			"type": "text",
			"icon": "user",
			"required": true,
			"question": "Enter company Name?",
			"placeholder": "Enter Name",
			"validation": {
				"condition": [
					{
						"case": {
							"regex_not_match": [
								{
									"var": "companyName"
								},
								"^[a-zA-Z0-9 .&()_-]{2,}$"
							]
						},
						"companyNameError": "Enter a valid company name"
					}
				]
			}
		}
	]
}
